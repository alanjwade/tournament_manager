{
  "name": "tournament-manager",
  "version": "1.0.32",
  "description": "Martial Arts Tournament Management Application",
  "main": "dist/src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build:watch\" \"wait-on dist/src/main/index.js && electron .\"",
    "typecheck": "tsc && tsc -p tsconfig.renderer.json",
    "build": "npm run typecheck && vite build",
    "build:watch": "tsc && concurrently \"tsc --watch\" \"tsc -p tsconfig.renderer.json --watch\" \"vite build --watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --win --linux"
  },
  "keywords": [
    "tournament",
    "martial-arts",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.17",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.1.14",
    "jspdf": "^2.5.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.7"
  },
  "build": {
    "appId": "com.tournament.manager",
    "productName": "TournamentManager",
    "icon": "src/renderer/assets/icons/app-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "src/renderer/assets/logos/**/*",
      "src/renderer/assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/assets/logos",
        "to": "assets/logos",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/icons/app-icon.png",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TournamentManager"
    },
    "publish": null
  }
}
